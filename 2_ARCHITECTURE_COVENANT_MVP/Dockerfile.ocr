# syntax=docker/dockerfile:1.7

FROM python:3.12-slim AS builder
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
WORKDIR /build
COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m pip wheel --wheel-dir /wheels .

FROM nvidia/cuda:12.9.1-cudnn-runtime-ubuntu24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/opt/venv/bin:$PATH \
    PADDLE_PDX_CACHE_HOME=/home/appuser/.paddlex \
    PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
       python3.12 python3.12-venv fonts-dejavu-core libgl1 libgomp1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && python3.12 -m venv /opt/venv \
    && groupmod --new-name appuser ubuntu \
    && usermod --login appuser --home /home/appuser --move-home ubuntu

RUN python -m pip install --upgrade pip \
    && python -m pip install --no-deps paddlepaddle-gpu==3.3.0 \
       --index-url https://www.paddlepaddle.org.cn/packages/stable/cu129/
COPY --from=builder /wheels /wheels
RUN python -m pip install /wheels/*.whl "paddleocr==3.4.1" \
       "protobuf>=3.20.2" "opt_einsum==3.3.0" networkx "safetensors>=0.6.0" \
    && rm -rf /wheels

WORKDIR /app
COPY scripts/ocr-healthcheck.sh /app/scripts/ocr-healthcheck.sh
RUN chmod 0555 /app/scripts/ocr-healthcheck.sh \
    && mkdir -p /app/data /home/appuser/.paddlex \
    && chown -R appuser:appuser /app /home/appuser

USER appuser
ENTRYPOINT ["halyk-covenants"]
CMD ["--help"]
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD ["/app/scripts/ocr-healthcheck.sh"]
